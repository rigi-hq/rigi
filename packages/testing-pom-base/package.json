{
  "name": "@rigi/testing-pom-base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./base-element": {
      "types": "./dist/base.element.d.ts",
      "default": "./dist/base.element.js"
    },
    "./base-screen": {
      "types": "./dist/base.screen.d.ts",
      "default": "./dist/base.screen.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@playwright/test": "catalog:",
    "allure-playwright": "catalog:"
  },
  "devDependencies": {
    "@rigi/tsconfig": "workspace:*",
    "@rigi/biome-config": "workspace:*",
    "typescript": "catalog:",
    "@biomejs/biome": "catalog:"
  }
}

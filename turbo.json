{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": { "dependsOn": ["^build"] },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["RIGI_*"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["RIGI_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["RIGI_*"]
    }
  }
}
